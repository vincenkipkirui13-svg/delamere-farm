<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="description" content="<%= description || 'Delamere Farm — quality livestock and dairy products.' %>">
  <meta name="theme-color" content="#143a29">
  <meta property="og:title" content="<%= title %> | <%= site.name %>">
  <meta property="og:description" content="<%= description || '' %>">
  <meta property="og:type" content="website">
  <link rel="icon" href="<%= site.icon ? '/uploads/' + site.icon : '/images/favicon.svg' %>">
  <link rel="apple-touch-icon" href="<%= site.icon ? '/uploads/' + site.icon : '/images/favicon.svg' %>">
  <link rel="stylesheet" href="/css/style.css">
  <title><%= title %> | <%= site.name %></title>
</head>
