<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="description" content="<%= description || site.description || '' %>"><meta name="robots" content="<%= site.seo.robots %>"><meta name="keywords" content="<%= site.seo.keywords %>"><link rel="canonical" href="<%= (siteUrl || 'https://delamerefarm.org').replace(/\/$/, '') %><%= currentPath === '/' ? '/' : currentPath %>"><meta name="theme-color" content="<%= site.branding.primary %>"><meta property="og:title" content="<%= title %> | <%= site.name %>"><meta property="og:description" content="<%= description || site.description || '' %>"><meta property="og:type" content="website"><meta property="og:url" content="<%= (siteUrl || 'https://delamerefarm.org').replace(/\/$/, '') %><%= currentPath === '/' ? '/' : currentPath %>"><% if(site.seo.socialImage){%><meta property="og:image" content="<%= (siteUrl || 'https://delamerefarm.org').replace(/\/$/, '') %>/uploads/<%= site.seo.socialImage %>"><%}%><meta name="twitter:card" content="summary_large_image"><link rel="icon" href="<%= site.icon ? '/uploads/'+site.icon : '/images/favicon.svg' %>"><link rel="apple-touch-icon" href="<%= site.icon ? '/uploads/'+site.icon : '/images/favicon.svg' %>"><link rel="stylesheet" href="/css/style.css"><style>:root{--primary-brand:<%= site.branding.primary %>;--secondary-brand:<%= site.branding.secondary %>;--accent-brand:<%= site.branding.accent %>}</style><title><%= title %> | <%= site.name %></title><script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"LocalBusiness",
  "@id":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "#business",
  "name":site.name || "Delamere Farm",
  "url":(siteUrl || "https://delamerefarm.org").replace(/\/$/,""),
  "description":description || site.description || "",
  "image":site.seo.socialImage ? (siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/uploads/" + site.seo.socialImage : undefined,
  "telephone":site.phone || undefined,
  "email":site.email || undefined,
  "address":site.location ? {"@type":"PostalAddress","addressLocality":site.location} : undefined,
  "sameAs":[site.social?.facebook,site.social?.instagram,site.social?.tiktok,site.social?.youtube].filter(Boolean)
}) %></script><script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"LocalBusiness","name":site.name || "Delamere Farm","url":(siteUrl || "https://delamerefarm.org").replace(/\/$/,""),"description":description || site.description || ""}) %></script></head>
