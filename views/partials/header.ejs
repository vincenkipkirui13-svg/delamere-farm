<header class="site-header" id="site-header"><div class="container header-inner"><a class="brand" href="/" aria-label="<%= site.name %> home"><% if(site.logo){%><img class="brand-logo" src="/uploads/<%= site.logo %>" alt="<%= site.name %> logo"><%}else{%><img class="brand-logo brand-logo-cow" src="https://images.pexels.com/photos/28610351/pexels-photo-28610351.jpeg?auto=compress&cs=tinysrgb&w=500" alt="Healthy Friesian cow, Delamere Farm logo" fetchpriority="high"><%}%><span class="brand-text"><%= site.name %></span></a><button class="menu-toggle" aria-label="Open menu" aria-controls="main-navigation" aria-expanded="false"><span></span><span></span><span></span></button><nav class="main-nav" id="main-navigation"><% (site.navItems||[]).forEach(item=>{ if(item.visible){ %><a class="<%= currentPath===item.path || (item.path!=='/'&&currentPath.startsWith(item.path))?'active':'' %> <%= item.label.toLowerCase()==='contact'?'nav-cta':'' %>" href="<%= item.path %>"><%= item.label %></a><% }}); %></nav></div></header>
