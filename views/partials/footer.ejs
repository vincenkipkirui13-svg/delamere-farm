<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <% if(site.footerLogo || site.logo){ %><img class="brand-logo" src="/uploads/<%= site.footerLogo || site.logo %>" alt="<%= site.name %> logo"><% } else { %><img class="brand-logo brand-logo-cow" src="https://images.pexels.com/photos/28610351/pexels-photo-28610351.jpeg?auto=compress&cs=tinysrgb&w=500" alt="Healthy Friesian cow, Delamere Farm logo" loading="lazy"><% } %>
        <span class="brand-text"><%= site.name %></span>
      </a>
      <p class="footer-copy"><%= site.footerText %></p>
    </div>
    <div><h3>Explore</h3><% (site.footerLinks||[]).slice(0,4).forEach(item=>{ %><a href="<%= item.path %>"><%= item.label %></a><% }) %></div>
    <div><h3>Help</h3><% (site.footerLinks||[]).slice(4).forEach(item=>{ %><a href="<%= item.path %>"><%= item.label %></a><% }) %><% if(site.phone){ %><a href="tel:<%= site.phone %>"><%= site.phone %></a><% } %><% if(site.email){ %><a href="mailto:<%= site.email %>"><%= site.email %></a><% } %></div>
    <div><h3>Connect</h3><% if(site.location){ %><span><%= site.location %></span><% } %><% if(site.address){ %><span><%= site.address %></span><% } %><% if(site.showSocialIcons){ %><% if(site.social.facebook){ %><a href="<%= site.social.facebook %>" target="_blank" rel="noopener">Facebook</a><% } %><% if(site.social.instagram){ %><a href="<%= site.social.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %><% if(site.social.tiktok){ %><a href="<%= site.social.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %><% if(site.social.youtube){ %><a href="<%= site.social.youtube %>" target="_blank" rel="noopener">YouTube</a><% } %><% } %><% if(site.mapsUrl){ %><a href="<%= site.mapsUrl %>" target="_blank" rel="noopener">Open in Google Maps</a><% } %></div>
  </div>
  <div class="container footer-bottom"><span><%= site.copyrightText || ('© '+new Date().getFullYear()+' '+site.name+'. All rights reserved.') %></span><a href="/admin/login">Staff Login</a></div>
</footer>
