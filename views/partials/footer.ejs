<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <% if (site.logo) { %><img class="brand-logo" src="/uploads/<%= site.logo %>" alt="<%= site.name %> logo"><% } else { %><span class="brand-mark">DF</span><% } %>
        <span class="brand-text"><%= site.name %></span>
      </a>
      <p class="footer-copy">A welcoming destination for quality livestock and our products, built around clear information, genuine farm imagery, and direct customer communication.</p>
    </div>
    <div><h3>Explore</h3><a href="/about">About Us</a><a href="/animals">Our Animals</a><a href="/dairy">Our Products</a><a href="/gallery">Gallery</a></div>
    <div><h3>Help</h3><a href="/faq">FAQ</a><a href="/contact">Contact</a><% if (site.phone) { %><a href="tel:<%= site.phone %>"><%= site.phone %></a><% } %><% if (site.email) { %><a href="mailto:<%= site.email %>"><%= site.email %></a><% } %></div>
    <div><h3>Connect</h3><% if (site.location) { %><span><%= site.location %></span><% } %><% if (site.social.facebook) { %><a href="<%= site.social.facebook %>" target="_blank" rel="noopener">Facebook</a><% } %><% if (site.social.instagram) { %><a href="<%= site.social.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %><% if (site.social.tiktok) { %><a href="<%= site.social.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %></div>
  </div>
  <div class="container footer-bottom"><span>© <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved.</span><a href="/admin/login">Staff Login</a></div>
</footer>
<% if (site.whatsapp || site.phone) { %>
<a
  class="whatsapp-float"
  href="<%= helpers.whatsappUrl(site.whatsapp || site.phone) %>"
  target="_blank"
  rel="noopener"
  aria-label="Chat with Delamere Farm on WhatsApp"
  title="Chat on WhatsApp"
>
  <span class="whatsapp-icon" aria-hidden="true">
    <svg viewBox="0 0 32 32">
      <path d="M16 3C8.82 3 3 8.82 3 16c0 2.3.6 4.56 1.73 6.56L3 29l6.63-1.69A12.93 12.93 0 0 0 16 29c7.18 0 13-5.82 13-13S23.18 3 16 3Zm0 23.64c-1.98 0-3.92-.53-5.62-1.54l-.4-.24-3.94 1 .99-3.84-.26-.4A10.98 10.98 0 1 1 16 26.64Zm6.03-8.26c-.33-.17-1.94-.96-2.24-1.07-.3-.11-.52-.17-.74.17-.22.33-.85 1.07-1.04 1.29-.19.22-.38.25-.7.08-.33-.17-1.39-.51-2.65-1.62-.98-.87-1.64-1.94-1.83-2.27-.19-.33-.02-.51.14-.68.15-.15.33-.38.49-.57.16-.19.22-.33.33-.55.11-.22.06-.41-.03-.57-.08-.17-.74-1.78-1.01-2.44-.27-.64-.54-.55-.74-.56h-.63c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.7s1.17 3.13 1.33 3.35c.16.22 2.3 3.51 5.57 4.92.78.34 1.39.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.94-.79 2.21-1.56.27-.77.27-1.43.19-1.56-.08-.14-.3-.22-.63-.39Z"/>
    </svg>
  </span>
</a>
<% } %>
<script src="/js/main.js" defer></script>
</body>
</html>
