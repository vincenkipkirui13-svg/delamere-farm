<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="brand footer-brand" href="/">
        <% if(site.footerLogo || site.logo){ %><img class="brand-logo" src="/uploads/<%= site.footerLogo || site.logo %>" alt="<%= site.name %> logo"><% } else { %><span class="brand-mark">DF</span><% } %>
        <span class="brand-text"><%= site.name %></span>
      </a>
      <p class="footer-copy"><%= site.footerText %></p>
    </div>
    <div><h3>Explore</h3><% (site.footerLinks||[]).slice(0,4).forEach(item=>{ %><a href="<%= item.path %>"><%= item.label %></a><% }) %></div>
    <div><h3>Help</h3><% (site.footerLinks||[]).slice(4).forEach(item=>{ %><a href="<%= item.path %>"><%= item.label %></a><% }) %><% if(site.phone){ %><a href="tel:<%= site.phone %>"><%= site.phone %></a><% } %><% if(site.email){ %><a href="mailto:<%= site.email %>"><%= site.email %></a><% } %></div>
    <div><h3>Connect</h3><% if(site.location){ %><span><%= site.location %></span><% } %><% if(site.address){ %><span><%= site.address %></span><% } %><% if(site.showSocialIcons){ %><% if(site.social.facebook){ %><a href="<%= site.social.facebook %>" target="_blank" rel="noopener">Facebook</a><% } %><% if(site.social.instagram){ %><a href="<%= site.social.instagram %>" target="_blank" rel="noopener">Instagram</a><% } %><% if(site.social.tiktok){ %><a href="<%= site.social.tiktok %>" target="_blank" rel="noopener">TikTok</a><% } %><% if(site.social.youtube){ %><a href="<%= site.social.youtube %>" target="_blank" rel="noopener">YouTube</a><% } %><% } %><% if(site.mapsUrl){ %><a href="<%= site.mapsUrl %>" target="_blank" rel="noopener">Open in Google Maps</a><% } %></div>
  </div>
  <div class="container footer-bottom"><span><%= site.copyrightText || ('© '+new Date().getFullYear()+' '+site.name+'. All rights reserved.') %></span><a href="/admin/login">Staff Login</a></div>
</footer>
<a class="call-float" href="tel:0727804038" aria-label="Call Delamere Farm on 0727804038" title="Call Delamere Farm"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.56 3.58.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.19 2.46.56 3.58a1 1 0 0 1-.25 1.01l-2.19 2.2Z"/></svg><span>Call</span></a>
<style>
.call-float{position:fixed;z-index:1000;right:88px;bottom:24px;display:flex;align-items:center;justify-content:center;gap:7px;min-height:54px;padding:0 16px;border-radius:999px;background:#143a29;color:#fff;text-decoration:none;font:700 14px/1 system-ui,sans-serif;box-shadow:0 8px 24px rgba(0,0,0,.22);transition:transform .2s,background .2s}
.call-float:hover{background:#20543b;transform:translateY(-2px)}
.call-float svg{width:20px;height:20px;fill:currentColor}
@media(max-width:760px){.call-float{right:67px;bottom:calc(11px + env(safe-area-inset-bottom));min-height:48px;width:48px;padding:0;gap:0}.call-float span{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}}
</style>
<script src="/js/main.js" defer></script></body></html>
