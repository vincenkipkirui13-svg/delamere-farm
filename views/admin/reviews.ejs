<%- include('../partials/head', { title, description: 'Manage customer reviews.' }) %>
<body class="admin-body">

<header class="admin-header">
  <div class="container admin-header-inner">
    <a class="brand" href="/admin">
      <span class="brand-mark">DF</span>
      <span class="brand-text">Delamere Farm <small>Staff</small></span>
    </a>

    <nav class="admin-top-nav">
      <a href="/">View website</a>
      <form method="post" action="/admin/logout">
        <button type="submit">Logout</button>
      </form>
    </nav>
  </div>
</header>

<main class="admin-main">
  <div class="container">

    <div class="admin-title">
      <div>
        <p class="eyebrow">Customer feedback</p>
        <h1>Reviews</h1>
        <p>Manage the reviews displayed on the public website.</p>
      </div>

      <a class="btn btn-secondary" href="/admin">Back to Dashboard</a>
    </div>

    <section class="admin-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Add review</p>
          <h2>Create a customer review</h2>
        </div>
      </div>

      <form method="post" action="/admin/reviews" class="admin-form">

        <label>
          Customer Name
          <input name="customer_name" required maxlength="100" placeholder="Customer name">
        </label>

        <label>
          Rating
          <select name="rating">
            <option value="5">★★★★★ — 5 stars</option>
            <option value="4">★★★★☆ — 4 stars</option>
            <option value="3">★★★☆☆ — 3 stars</option>
            <option value="2">★★☆☆☆ — 2 stars</option>
            <option value="1">★☆☆☆☆ — 1 star</option>
          </select>
        </label>

        <label>
          Review
          <textarea name="review_text" required maxlength="500" rows="4" placeholder="Short customer review"></textarea>
        </label>

        <label class="checkbox-row">
          <input type="checkbox" name="published" checked>
          <span>Publish this review</span>
        </label>

        <button class="btn btn-primary" type="submit">Add Review</button>
      </form>
    </section>

    <section class="admin-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">Customer feedback</p>
          <h2>Reviews</h2>
        </div>

        <a class="text-link" href="/#reviews">View public reviews →</a>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Customer</th>
              <th>Rating</th>
              <th>Review</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% reviews.forEach(review => { %>
              <tr>
                <td>
                  <strong><%= review.customer_name %></strong>
                </td>

                <td>
                  <span class="review-stars">
                    <%= '★'.repeat(review.rating) %><%= '☆'.repeat(5 - review.rating) %>
                  </span>
                </td>

                <td>
                  <%= review.review_text %>
                </td>

                <td>
                  <span class="admin-status <%= review.published ? 'resolved' : 'new' %>">
                    <%= review.published ? 'Published' : 'Hidden' %>
                  </span>
                </td>

                <td>
                  <form method="post" action="/admin/reviews/<%= review.id %>/publish" style="display:inline">
                    <input type="hidden" name="published" value="<%= review.published ? '0' : '1' %>">
                    <button type="submit">
                      <%= review.published ? 'Hide' : 'Publish' %>
                    </button>
                  </form>

                  <form method="post" action="/admin/reviews/<%= review.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this review?')">
                    <button type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>

            <% if (!reviews.length) { %>
              <tr>
                <td colspan="5">
                  <div class="empty-state">No reviews yet.</div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</main>

</body>
</html>