<%- include('../partials/head', { title, description: 'Manage customer reviews.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Customer feedback</p><h1>Reviews</h1><p>Manage testimonials shown on the public homepage.</p></div></div><section class="admin-panel"><div class="form-card"><form method="post" action="/admin/reviews"><%- include('csrf') %><div class="form-grid"><label>Customer name<input name="customer_name" required maxlength="100"></label><label>Rating<select name="rating"><% [5,4,3,2,1].forEach(x=>{%><option value="<%= x %>"><%= x %> / 5</option><%})%></select></label></div><label>Review<textarea name="review_text" required maxlength="500" rows="4"></textarea></label><label class="checkbox"><input type="checkbox" name="published" checked> Published</label><button class="btn btn-primary">Add Review</button></form></div></section><section class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Rating</th><th>Review</th><th>Status</th><th>Actions</th></tr></thead><tbody><% reviews.forEach(review=>{%><tr><td><strong><%= review.customer_name %></strong></td><td><%= '★'.repeat(review.rating) %><%= '☆'.repeat(5-review.rating) %></td><td><%= review.review_text %></td><td><span class="admin-status <%= review.published?'resolved':'new' %>"><%= review.published?'Published':'Hidden' %></span></td><td><form class="inline-form" method="post" action="/admin/reviews/<%= review.id %>/publish"><%- include('csrf') %><input type="hidden" name="published" value="<%= review.published?'0':'1' %>"><button class="table-link"><%= review.published?'Hide':'Publish' %></button></form><form class="inline-form" method="post" action="/admin/reviews/<%= review.id %>/delete" onsubmit="return confirm('Delete this review?')"><%- include('csrf') %><button class="danger-link">Delete</button></form></td></tr><%})%><%if(!reviews.length){%><tr><td colspan="5">No reviews yet.</td></tr><%}%></tbody></table></div><div class="pagination" aria-label="Reviews pages"><% if(page > 1){ %><a class="btn btn-secondary" href="/admin/reviews?page=<%= page-1 %>">← Previous</a><% } %><span>Page <%= page %> of <%= totalPages %> · <%= total %> reviews</span><% if(page < totalPages){ %><a class="btn btn-secondary" href="/admin/reviews?page=<%= page+1 %>">Next →</a><% } %></div></section></div></main></body></html>
