<%- include('../partials/head', { title, description: 'Manage a product.' }) %><body class="admin-body"><header class="admin-header"><div class="container admin-header-inner"><a class="brand" href="/admin"><span class="brand-mark">DF</span><span class="brand-text">Delamere Farm Admin</span></a><nav><a href="/admin/settings">Settings</a><a href="/admin/dairy">Dairy</a><a href="/admin">Dashboard</a></nav></div></header><main class="admin-main"><div class="container narrow"><div class="admin-title"><div><p class="eyebrow">Catalog</p><h1><%= product ? 'Edit Product' : 'Add Product' %></h1></div></div><div class="form-card"><% if (error) { %><div class="form-errors"><%= error %></div><% } %><form method="post" action="<%= product ? '/admin/dairy/'+product.id : '/admin/dairy' %>" enctype="multipart/form-data"><div class="form-grid"><label>Name *<input name="name" required maxlength="100" value="<%= product?.name || '' %>"></label><label>Slug<input name="slug" maxlength="120" value="<%= product?.slug || '' %>"></label><label>Availability<select name="availability"><% ['Available','On Request','Unavailable'].forEach(status => { %><option <%= (product?.availability || 'Available') === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif"><small>Up to 6 MB.</small></label></div><label>Description *<textarea name="description" required maxlength="2000" rows="8"><%= product?.description || '' %></textarea></label><label class="checkbox"><input type="checkbox" name="featured" <%= product?.featured ? 'checked' : '' %>> Feature this product on the homepage</label><div class="button-row"><button class="btn btn-primary" type="submit">Save Product</button><a class="btn btn-secondary" href="/admin/dairy">Cancel</a></div></form></div></div></main></body></html>

