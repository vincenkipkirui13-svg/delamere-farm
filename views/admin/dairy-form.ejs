<%- include('../partials/head', { title, description: 'Manage a Delamere Farm dairy product.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container narrow"><div class="admin-title"><div><p class="eyebrow">Dairy Products</p><h1><%= product?'Edit Product':'Add Product' %></h1></div></div><% if(error){%><div class="form-errors"><%= error %></div><%}%><div class="form-card"><form method="post" action="<%= product?'/admin/dairy/'+product.id:'/admin/dairy' %>" enctype="multipart/form-data"><%- include('csrf') %><div class="form-grid"><label>Name *<input name="name" required maxlength="100" value="<%= product?.name||'' %>"></label><label>Slug<input name="slug" maxlength="120" value="<%= product?.slug||'' %>"></label><label>Category<input name="category" list="dairy-categories" maxlength="80" value="<%= product?.category||'Other dairy products' %>" placeholder="e.g. Fresh milk"><datalist id="dairy-categories"><option value="Fresh milk"><option value="Yoghurt"><option value="Butter"><option value="Cream"><option value="Other dairy products"></datalist></label><label>Price (KSh)<input type="number" name="price" min="0" step="1" value="<%= product?.price??'' %>"></label><label>Unit<input name="unit" maxlength="40" value="<%= product?.unit||'' %>" placeholder="e.g. litre, 500g"></label><label>Availability<select name="availability"><% ['Available','On Request','Unavailable'].forEach(x=>{%><option <%= (product?.availability||'Available')===x?'selected':'' %>><%= x %></option><%})%></select></label><label>Display order<input type="number" name="display_order" min="0" value="<%= product?.display_order||0 %>"></label><label>Product image<input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"></label></div><label>Description *<textarea name="description" required maxlength="2000" rows="8"><%= product?.description||'' %></textarea></label><label class="checkbox"><input type="checkbox" name="featured" <%= product?.featured?'checked':'' %>> Feature this product on the homepage</label><div class="button-row"><button class="btn btn-primary">Save Product</button><a class="btn btn-secondary" href="/admin/dairy">Cancel</a></div></form></div></div></main></body></html>
