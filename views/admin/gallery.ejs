<%- include('../partials/head', { title, description: 'Manage Delamere Farm gallery.' }) %><body class="admin-body"><header class="admin-header"><div class="container admin-header-inner"><a class="brand" href="/admin"><span class="brand-mark">DF</span><span class="brand-text">Delamere Farm Admin</span></a><nav><a href="/admin/settings">Settings</a><a href="/">Site</a><a href="/admin">Dashboard</a></nav></div></header><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Photography</p><h1>Gallery</h1></div></div><div class="form-card"><form method="post" action="/admin/gallery" enctype="multipart/form-data"><div class="form-grid"><label>Title *<input name="title" required maxlength="120"></label><label>Category *<input name="category" required maxlength="50" placeholder="Farm, Animals, Dairy"></label><label>Image *<input type="file" name="image" required accept="image/jpeg,image/png,image/webp,image/avif"></label><label>Description<input name="description" maxlength="500"></label></div><label class="checkbox"><input type="checkbox" name="featured"> Feature on homepage</label><button class="btn btn-primary" type="submit">Upload Photo</button></form></div><section class="admin-panel"><div class="admin-thumb-grid"><% items.forEach(item => { %><article class="admin-thumb"><img src="<%= '/uploads/'+item.image %>" alt="<%= item.title %>"><div><strong><%= item.title %></strong><small><%= item.category %></small><form method="post" action="/admin/gallery/<%= item.id %>/delete" onsubmit="return confirm('Delete this photo?')"><button class="danger-link" type="submit">Delete</button></form></div></article><% }) %></div></section></div></main></body></html>
