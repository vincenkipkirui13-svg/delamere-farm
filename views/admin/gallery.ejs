<%- include('../partials/head', { title, description: 'Manage Delamere Farm gallery.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Photography</p><h1>Gallery</h1><p>Upload, edit, replace and order photographs. Images are displayed without forced cropping on the public gallery.</p></div></div><div class="form-card"><form method="post" action="/admin/gallery" enctype="multipart/form-data"><%- include('csrf') %><div class="form-grid"><label>Title *<input name="title" required maxlength="120"></label><label>Category<input name="category" list="gallery-categories" maxlength="80" value="Farm" placeholder="e.g. Livestock"><datalist id="gallery-categories"><option value="Farm"><option value="Livestock"><option value="Cattle"><option value="Sheep"><option value="Dairy"><option value="Facilities"><option value="Pasture"><option value="Team"><option value="Events"><option value="Other"></datalist></label><label>Image *<input type="file" name="image" required accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"></label><label>Display order<input type="number" name="display_order" value="0" min="0"></label></div><label>Description<input name="description" maxlength="500"></label><label class="checkbox"><input type="checkbox" name="featured"> Feature on homepage</label><button class="btn btn-primary">Upload Photo</button></form></div><section class="admin-panel"><div class="admin-thumb-grid"><% items.forEach(item=>{%><article class="admin-thumb gallery-admin-card"><img src="/uploads/<%= item.image %>" alt="<%= item.title %>" loading="lazy"><form method="post" action="/admin/gallery/<%= item.id %>"><%- include('csrf') %><label>Title<input name="title" value="<%= item.title %>" maxlength="120"></label><label>Category<input name="category" value="<%= item.category %>" maxlength="80"></label><label>Description<input name="description" value="<%= item.description||'' %>" maxlength="500"></label><div class="form-grid"><label>Order<input type="number" name="display_order" value="<%= item.display_order||0 %>" min="0"></label><label class="checkbox"><input type="checkbox" name="featured" <%= item.featured?'checked':'' %>> Featured</label></div><button class="table-link">Save</button></form><form method="post" action="/admin/gallery/<%= item.id %>/replace" enctype="multipart/form-data"><%- include('csrf') %><input type="file" name="image" required accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"><button class="table-link">Replace image</button></form><form method="post" action="/admin/gallery/<%= item.id %>/delete" onsubmit="return confirm('Delete this photo?')"><%- include('csrf') %><button class="danger-link">Delete</button></form></article><%})%></div><% if(!items.length){%><div class="empty-state">No gallery images yet.</div><%}%></section></div></main></body></html>
