<%- include('../partials/head', { title, description: 'Manage administrator security and activity.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Security</p><h1>Security & Activity</h1><p>Protect administrator access, active sessions and recent account activity.</p></div></div><% if(error){%><div class="form-errors"><%= error %></div><%}%><% if(success){%><div class="settings-success"><%= success %></div><%}%><section class="admin-panel"><div class="panel-heading"><h2>Change your password</h2></div><div class="form-card"><form method="post" action="/admin/security/password"><%- include('csrf') %><div class="form-grid"><label>Current password<input type="password" name="current_password" required autocomplete="current-password"></label><label>New password<input type="password" name="new_password" required minlength="10" autocomplete="new-password"></label><label>Confirm new password<input type="password" name="confirm_password" required minlength="10" autocomplete="new-password"></label></div><button class="btn btn-primary">Change Password</button></form></div></section><section class="admin-panel"><div class="panel-heading"><div><h2>Active sessions</h2><p>Administrator sessions are stored in the site's database and can be revoked here without affecting public visitor sessions.</p></div><form method="post" action="/admin/security/sessions/revoke-all" onsubmit="return confirm('Sign out all other administrator sessions?')"><%- include('csrf') %><button class="btn btn-secondary">Sign out other sessions</button></form></div><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Expires</th><th>Current</th></tr></thead><tbody><% (sessions||[]).forEach(item=>{%><tr><td><%= item.username %></td><td><%= item.role %></td><td><%= new Date(item.expires_at).toLocaleString('en-GB') %></td><td><%= item.current?'This device':'Other session' %></td></tr><%})%><%if(!(sessions||[]).length){%><tr><td colspan="4">No active sessions found.</td></tr><%}%></tbody></table></div></section><section class="admin-panel"><div class="panel-heading"><h2>Recent activity</h2></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th></tr></thead><tbody><% activity.forEach(item=>{%><tr><td><%= item.created_at %></td><td><%= item.username||'Unknown' %></td><td><%= item.action %></td><td><%= item.entity_type||'-' %> <%= item.entity_id||'' %></td><td><%= item.ip_address||'-' %></td></tr><%})%><% if(!activity.length){%><tr><td colspan="5">No activity recorded yet.</td></tr><%}%></tbody></table></div></section></div></main></body></html>
