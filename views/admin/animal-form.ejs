<%- include('../partials/head', { title, description: 'Manage an animal.' }) %><body class="admin-body"><header class="admin-header"><div class="container admin-header-inner"><a class="brand" href="/admin"><span class="brand-mark">DF</span><span class="brand-text">Delamere Farm Admin</span></a><nav><a href="/admin/settings">Settings</a><a href="/admin/animals">Animals</a><a href="/admin">Dashboard</a></nav></div></header><main class="admin-main"><div class="container narrow"><div class="admin-title"><div><p class="eyebrow">Catalog</p><h1><%= animal ? 'Edit Animal' : 'Add Animal' %></h1></div></div><div class="form-card"><% if (error) { %><div class="form-errors"><%= error %></div><% } %><form method="post" action="<%= animal ? '/admin/animals/'+animal.id : '/admin/animals' %>" enctype="multipart/form-data"><div class="form-grid"><label>Name *<input name="name" required maxlength="100" value="<%= animal?.name || '' %>"></label><label>Slug<input name="slug" maxlength="120" value="<%= animal?.slug || '' %>" placeholder="auto-generated if blank"></label><label>Category *<input name="category" required maxlength="60" value="<%= animal?.category || '' %>" placeholder="Dairy Cattle"></label><label>Breed<input name="breed" maxlength="100" value="<%= animal?.breed || '' %>"></label><label>Age<input name="age" maxlength="40" value="<%= animal?.age || '' %>"></label><label>Gender<input name="gender" maxlength="30" value="<%= animal?.gender || '' %>"></label><label>Availability<select name="availability"><% ['Available','On Request','Sold'].forEach(status => { %><option <%= (animal?.availability || 'Available') === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif"><small>Up to 6 MB. JPG, PNG, WEBP or AVIF.</small></label></div><label>Description *<textarea name="description" required maxlength="2000" rows="8"><%= animal?.description || '' %></textarea></label><label class="checkbox"><input type="checkbox" name="featured" <%= animal?.featured ? 'checked' : '' %>> Feature this animal on the homepage</label><div class="button-row"><button class="btn btn-primary" type="submit"><%= animal ? 'Save Changes' : 'Add Animal' %></button><a class="btn btn-secondary" href="/admin/animals">Cancel</a></div></form></div></div></main></body></html>
