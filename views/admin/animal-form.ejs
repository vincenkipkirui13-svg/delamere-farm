<%- include('../partials/head', { title, description: 'Manage an individual Delamere Farm animal.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container narrow"><div class="admin-title"><div><p class="eyebrow">Individual livestock</p><h1><%= animal ? 'Edit Animal' : 'Add Animal' %></h1></div></div><% if(error){%><div class="form-errors"><%= error %></div><%}%>
<div class="form-card"><form method="post" action="<%= animal?'/admin/animals/'+animal.id:'/admin/animals' %>" enctype="multipart/form-data"><%- include('csrf') %><div class="form-grid">
<label>Animal name *<input name="name" required maxlength="100" value="<%= animal?.name||'' %>"></label>
<label>Species / livestock type<select id="animal-livestock-type" name="livestock_type"><option value="">Select type</option><% types.forEach(type=>{%><option value="<%= type.name %>" <%= (animal?.livestock_type||'')===type.name?'selected':'' %>><%= type.name %></option><%})%></select></label>
<label>Category / classification<select id="animal-classification" name="livestock_classification"><option value="">Select classification</option><% classifications.forEach(c=>{%><option value="<%= c.name %>" data-type="<%= c.livestock_type_name %>" <%= (animal?.livestock_classification||'')===c.name?'selected':'' %>><%= c.name %></option><%})%></select></label>
<label>Breed<select id="animal-breed" name="breed_id"><option value="">Select breed</option><% breedOptions.forEach(b=>{%><option value="<%= b.id %>" data-type="<%= b.livestock_type_name %>" <%= Number(animal?.breed_id)===Number(b.id)?'selected':'' %>><%= b.name %></option><%})%></select></label>
<label>Additional category label<input name="category" maxlength="60" value="<%= animal?.category||'' %>" placeholder="e.g. Dairy Cattle"></label><label>Sex / Gender<select name="sex"><option value="">Select</option><% ['Female','Male','Unknown'].forEach(x=>{%><option <%= (animal?.sex||animal?.gender||'')===x?'selected':'' %>><%= x %></option><%})%></select></label>
<label>Age<input name="age" maxlength="40" value="<%= animal?.age||'' %>"></label>
<label>Price (KSh)<input type="number" name="price" min="0" step="1" value="<%= animal?.price??'' %>"></label><label>Price range<input name="price_range" maxlength="100" value="<%= animal?.price_range||'' %>" placeholder="e.g. KSh 150,000 - 200,000"></label>
<label>Availability<select name="availability"><% ['Available','On Request','Sold'].forEach(x=>{%><option <%= (animal?.availability||'Available')===x?'selected':'' %>><%= x %></option><%})%></select></label><label>Display order<input type="number" name="display_order" min="0" value="<%= animal?.display_order||0 %>"></label>
<label>Main photograph<input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"><small>Up to 6 MB.</small></label>
</div><label>Description *<textarea name="description" required maxlength="2000" rows="7"><%= animal?.description||'' %></textarea></label><label class="checkbox"><input type="checkbox" name="featured" <%= animal?.featured?'checked':'' %>> Feature this animal</label><div class="button-row"><button class="btn btn-primary">Save Animal</button><a class="btn btn-secondary" href="/admin/animals">Cancel</a></div></form></div>
<% if(animal){ %><section class="admin-panel animal-photos-panel"><div class="panel-heading"><div><p class="eyebrow">Additional photos</p><h2>Animal gallery</h2></div></div><div class="form-card"><form method="post" action="/admin/animals/<%= animal.id %>/photos" enctype="multipart/form-data"><%- include('csrf') %><label>Upload additional photographs<input type="file" name="images" multiple accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"><small>You can select up to 12 images per upload.</small></label><button class="btn btn-primary">Upload Photos</button></form></div><div class="admin-thumb-grid"><% (photos||[]).forEach(photo=>{ %><article class="admin-thumb"><img src="/uploads/<%= photo.image %>" alt="Additional animal photo"><form method="post" action="/admin/animals/<%= animal.id %>/photos/<%= photo.id %>/delete" onsubmit="return confirm('Delete this photograph?')"><%- include('csrf') %><button class="danger-link">Delete</button></form></article><% }) %></div></section><% } %>
</div></main><script>(function(){const t=document.getElementById('animal-livestock-type'),c=document.getElementById('animal-classification'),b=document.getElementById('animal-breed');if(!t||!c||!b)return;function filter(){const v=t.value;[...c.options].forEach(o=>{if(o.value)o.hidden=!!(v&&o.dataset.type!==v)});[...b.options].forEach(o=>{if(o.value)o.hidden=!!(v&&o.dataset.type!==v)});}t.addEventListener('change',filter);filter();})();</script></body></html>
