<%- include('../partials/head', { title, description: 'Manage livestock collection and classification photographs.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Livestock appearance</p><h1>Livestock Collection Photos</h1><p>Manage photographs for livestock types and classifications.</p></div></div><section class="catalog-admin-section"><div class="panel-heading"><h2>Main Collections</h2></div><div class="catalog-admin-grid"><% types.forEach(type=>{%><article class="catalog-admin-card"><div class="catalog-admin-media"><%if(type.image){%><img src="<%= helpers.imageUrl(type.image) %>" alt="<%= type.name %>"><%}else{%><div class="catalog-admin-empty">No photograph uploaded</div><%}%></div><div class="catalog-admin-body"><p class="card-kicker">Livestock Type</p><h3><%= type.name %></h3><p><%= type.description||'' %></p><form method="post" action="/admin/livestock-types/<%= type.id %>/photo" enctype="multipart/form-data"><%- include('csrf') %><label>Photograph<input type="file" name="image" required accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"></label><button class="btn btn-primary"><%= type.image?'Replace Photograph':'Upload Photograph' %></button></form><%if(type.image){%><form method="post" action="/admin/livestock-types/<%= type.id %>/photo/delete"><%- include('csrf') %><button class="danger-link">Remove photograph</button></form><%}%></div></article><%})%></div></section><section class="catalog-admin-section"><div class="panel-heading"><h2>Classification Photos</h2></div><div class="catalog-admin-grid"><% classifications.forEach(c=>{%><article class="catalog-admin-card"><div class="catalog-admin-media"><%if(c.image){%><img src="<%= helpers.imageUrl(c.image) %>" alt="<%= c.name %>"><%}else{%><div class="catalog-admin-empty">No photograph uploaded</div><%}%></div><div class="catalog-admin-body"><p class="card-kicker"><%= c.livestock_type_name %></p><h3><%= c.name %></h3><form method="post" action="/admin/livestock-classifications/<%= c.id %>/photo" enctype="multipart/form-data"><%- include('csrf') %><label>Photograph<input type="file" name="image" required accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"></label><button class="btn btn-primary"><%= c.image?'Replace Photograph':'Upload Photograph' %></button></form><%if(c.image){%><form method="post" action="/admin/livestock-classifications/<%= c.id %>/photo/delete"><%- include('csrf') %><button class="danger-link">Remove photograph</button></form><%}%></div></article><%})%></div></section></div></main></body></html>