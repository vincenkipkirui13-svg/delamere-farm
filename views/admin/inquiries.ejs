<%- include('../partials/head', { title, description: 'Customer inquiries for Delamere Farm.' }) %><body class="admin-body"><header class="admin-header"><div class="container admin-header-inner"><a class="brand" href="/admin"><span class="brand-mark">DF</span><span class="brand-text">Delamere Farm Admin</span></a><nav><a href="/admin/settings">Settings</a><a href="/">Site</a><a href="/admin">Dashboard</a></nav></div></header><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Customer communication</p><h1>Inquiries</h1></div></div><section class="inquiry-list"><% if (!inquiries.length) { %><div class="empty-state">No customer inquiries have been received yet.</div><% } %><% inquiries.forEach(item => { %><article class="inquiry-card"><div class="inquiry-head"><div><h3><%= item.full_name %></h3><p><a href="tel:<%= item.phone %>"><%= item.phone %></a><% if (item.email) { %> · <a href="mailto:<%= item.email %>"><%= item.email %></a><% } %></p></div><form method="post" action="/admin/inquiries/<%= item.id %>/status"><select name="status" onchange="this.form.submit()"><% ['New','Contacted','Resolved'].forEach(status => { %><option <%= item.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></form></div><div class="inquiry-interest"><span>Interest</span><strong><%= item.animal_name || item.product_name || item.inquiry_type %></strong></div><p class="inquiry-message"><%= item.message %></p><small><%= item.created_at %></small></article><% }) %></section></div></main></body></html>
