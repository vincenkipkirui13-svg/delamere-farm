<%- include('../partials/head', { title, description: 'Customer inquiries for Delamere Farm.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Customer communication</p><h1>Inquiries</h1><p>Track new, read, replied and archived customer messages.</p></div></div><section class="inquiry-admin-list"><% inquiries.forEach(item=>{%><article class="inquiry-admin-card"><div class="inquiry-admin-head"><div><h2><%= item.subject||item.inquiry_type %></h2><strong><%= item.full_name %></strong><small><%= item.phone %><% if(item.email){%> · <%= item.email %><%}%></small></div><span class="admin-status <%= item.status.toLowerCase() %>"><%= item.status %></span></div><p><strong>Type:</strong> <%= item.inquiry_type %><% if(item.animal_name){%> · <strong>Animal:</strong> <%= item.animal_name %><%}%><% if(item.product_name){%> · <strong>Product:</strong> <%= item.product_name %><%}%></p><p class="inquiry-message"><%= item.message %></p><small>Received: <%= item.created_at %></small><div class="button-row"><form method="post" action="/admin/inquiries/<%= item.id %>/status"><%- include('csrf') %><select name="status"><% ['New','Read','Replied','Archived'].forEach(x=>{%><option <%= item.status===x?'selected':'' %>><%= x %></option><%})%></select><button class="btn btn-secondary">Update Status</button></form><% if(item.email){%><a class="btn btn-secondary" href="mailto:<%= item.email %>?subject=<%= encodeURIComponent('Re: '+(item.subject||'Your inquiry')) %>">Reply by Email</a><%}%><form method="post" action="/admin/inquiries/<%= item.id %>/delete" onsubmit="return confirm('Delete this inquiry?')"><%- include('csrf') %><button class="danger-link">Delete</button></form></div></article><%})%><% if(!inquiries.length){%><div class="empty-state">No inquiries yet.</div><%}%></section></div></main></body></html>
