<%- include('../partials/head', { title, description: 'Manage Delamere Farm products.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Our Products</p><h1>Product Catalogue</h1></div><a class="btn btn-primary" href="/admin/dairy/new">+ Add Product</a></div><section class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Product</th><th>Category</th><th>Price</th><th>Status</th><th>Featured</th><th>Actions</th></tr></thead><tbody><% products.forEach(product=>{%><tr><td><div class="admin-media"><img src="<%= product.image?'/uploads/'+product.image:'/images/placeholder.svg' %>" alt=""><div><strong><%= product.name %></strong><small><%= product.unit||'' %></small></div></div></td><td><%= product.category %></td><td><%= product.price!==null&&product.price!==undefined?'KSh '+Number(product.price).toLocaleString('en-KE'):'-' %></td><td><%= product.availability %></td><td><%= product.featured?'Yes':'No' %></td><td><a class="table-link" href="/admin/dairy/<%= product.id %>/edit">Edit</a><form class="inline-form" method="post" action="/admin/dairy/<%= product.id %>/delete" onsubmit="return confirm('Delete this product?')"><%- include('csrf') %><button class="danger-link">Delete</button></form></td></tr><%})%><%if(!products.length){%><tr><td colspan="6">No products added yet.</td></tr><%}%></tbody></table></div></section></div></main></body></html>
