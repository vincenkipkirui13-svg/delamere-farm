<%- include('../partials/head', { title, description: 'Manage Delamere Farm our products.' }) %><body class="admin-body"><header class="admin-header"><div class="container admin-header-inner"><a class="brand" href="/admin"><span class="brand-mark">DF</span><span class="brand-text">Delamere Farm Admin</span></a><nav><a href="/admin/settings">Settings</a><a href="/">Site</a><a href="/admin">Dashboard</a></nav></div></header><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Catalog</p><h1>Our Products</h1></div><a class="btn btn-primary" href="/admin/dairy/new">+ Add Product</a></div><section class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Product</th><th>Status</th><th>Featured</th><th>Actions</th></tr></thead><tbody><% products.forEach(product => { %><tr><td><div class="admin-media"><img src="<%= product.image ? '/uploads/'+product.image : '/images/placeholder.svg' %>" alt=""><div><strong><%= product.name %></strong></div></div></td><td><%= product.availability %></td><td><%= product.featured ? 'Yes' : 'No' %></td><td><a class="table-link" href="/admin/dairy/<%= product.id %>/edit">Edit</a><form class="inline-form" method="post" action="/admin/dairy/<%= product.id %>/delete" onsubmit="return confirm('Delete this product?')"><button class="danger-link" type="submit">Delete</button></form></td></tr><% }) %><% if (!products.length) { %><tr><td colspan="4">No our products added yet.</td></tr><% } %></tbody></table></div></section></div></main></body></html>

