<%- include('../partials/head', { title, description: 'Manage Delamere Farm FAQs.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Customer help</p><h1>FAQs</h1><p>Add, edit, publish, unpublish and reorder frequently asked questions.</p></div></div><div class="form-card"><form method="post" action="/admin/faqs"><%- include('csrf') %><div class="form-grid"><label>Question *<input name="question" required maxlength="200"></label><label>Category<select name="category"><option>General</option><option>Livestock</option><option>Dairy</option><option>Visits</option><option>Delivery</option><option>Contact</option></select></label><label>Display order<input type="number" name="display_order" value="0" min="0"></label></div><label>Answer *<textarea name="answer" required maxlength="2000" rows="5"></textarea></label><label class="checkbox"><input type="checkbox" name="active" checked> Published</label><button class="btn btn-primary">Add FAQ</button></form></div><section class="faq-admin-list"><% faqs.forEach(faq=>{%><article class="admin-faq"><form method="post" action="/admin/faqs/<%= faq.id %>"><%- include('csrf') %><div class="form-grid"><label>Question<input name="question" value="<%= faq.question %>" required maxlength="200"></label><label>Category<input name="category" value="<%= faq.category||'General' %>" maxlength="80"></label><label>Order<input type="number" name="display_order" value="<%= faq.display_order %>" min="0"></label></div><label>Answer<textarea name="answer" required maxlength="2000" rows="5"><%= faq.answer %></textarea></label><label class="checkbox"><input type="checkbox" name="active" <%= faq.active?'checked':'' %>> Published</label><button class="table-link">Save Changes</button></form><form method="post" action="/admin/faqs/<%= faq.id %>/delete" onsubmit="return confirm('Delete this FAQ?')"><%- include('csrf') %><button class="danger-link">Delete</button></form></article><%})%></section></div></main></body></html>
