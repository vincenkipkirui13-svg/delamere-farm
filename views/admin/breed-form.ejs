<%- include('../partials/head', { title, description: 'Manage a livestock breed.' }) %>
<body class="admin-body admin-shell"><%- include('nav') %><main class="admin-main"><div class="container narrow"><div class="admin-title"><div><p class="eyebrow">Breed Library</p><h1><%= breed?'Edit Breed':'Add Breed' %></h1></div></div><% if(error){%><div class="form-errors"><%= error %></div><%}%><div class="form-card"><form method="post" action="<%= breed?'/admin/breeds/'+breed.id:'/admin/breeds' %>" enctype="multipart/form-data"><%- include('csrf') %><div class="form-grid"><label>Livestock type<select name="livestock_type" required <%= breed?'disabled':'' %>><option value="">Select type</option><% types.forEach(type=>{%><option value="<%= type.name %>" <%= (breed?.livestock_type||'')===type.name?'selected':'' %>><%= type.name %></option><%})%></select></label><label>Breed name *<input name="name" required maxlength="120" value="<%= breed?.name||'' %>"></label><label>Slug<input name="slug" maxlength="140" value="<%= breed?.slug||'' %>"></label><label>Display order<input type="number" name="display_order" min="0" value="<%= breed?.display_order||0 %>"></label><label>Breed photograph<input type="file" name="image" accept=".jpg,.jpeg,.png,.webp,.avif,image/jpeg,image/png,image/webp,image/avif"></label></div><fieldset class="checkbox-group"><legend>Classification(s)</legend><div class="checkbox-grid"><% classifications.forEach(c=>{%><label class="checkbox"><input type="checkbox" name="classifications" value="<%= c.id %>" data-type="<%= c.livestock_type_name %>" <%= (breed?.classificationIds||[]).includes(c.id)?'checked':'' %>><%= c.livestock_type_name %> — <%= c.name %></label><%})%></div></fieldset><label>Description<textarea name="description" maxlength="2000" rows="7"><%= breed?.description||'' %></textarea></label><label class="checkbox"><input type="checkbox" name="featured" <%= breed?.featured?'checked':'' %>> Featured breed</label><div class="button-row"><button class="btn btn-primary">Save Breed</button><a class="btn btn-secondary" href="/admin/breeds">Cancel</a></div></form></div></div></main></body></html>
