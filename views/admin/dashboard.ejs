<%- include('../partials/head', { title, description: 'Delamere Farm administration dashboard.' }) %>
<body class="admin-body admin-shell">
  <%- include('nav') %>
  <main class="admin-main">
    <div class="container">
      <div class="admin-title">
        <div>
          <p class="eyebrow">Control centre</p>
          <h1>Dashboard</h1>
          <p>Manage the public Delamere Farm website without editing code.</p>
        </div>
        <div class="button-row">
          <a class="btn btn-secondary" href="/" target="_blank" rel="noopener">View Website</a>
          <a class="btn btn-primary" href="/admin/settings#homepage">Edit Homepage</a>
        </div>
      </div>

      <div class="stat-grid">
        <a href="/admin/breeds" class="stat-card"><span>Livestock Breeds</span><strong><%= stats.breeds %></strong><small>Breed library</small></a>
        <a href="/admin/animals" class="stat-card"><span>Individual Animals</span><strong><%= stats.animals %></strong><small>Animal listings</small></a>
        <a href="/admin/dairy" class="stat-card"><span>Dairy Products</span><strong><%= stats.dairy %></strong><small>Product catalogue</small></a>
        <a href="/admin/gallery" class="stat-card"><span>Gallery Images</span><strong><%= stats.gallery %></strong><small>Farm photographs</small></a>
        <a href="/admin/faqs" class="stat-card"><span>FAQs</span><strong><%= stats.faqs %></strong><small>Customer answers</small></a>
        <a href="/admin/inquiries" class="stat-card stat-accent"><span>Inquiries</span><strong><%= stats.inquiries %></strong><small><%= stats.newInquiries %> new</small></a>
        <a href="/admin/reviews" class="stat-card"><span>Reviews</span><strong><%= stats.reviews %></strong><small>Customer feedback</small></a>
      </div>

      <section class="admin-section-block">
        <div class="section-heading-row"><div><p class="eyebrow">Quick actions</p><h2>Common tasks</h2></div></div>
        <div class="admin-actions">
          <a class="admin-action" href="/admin/animals/new"><span>+</span><b>Add Animal</b><small>Create an individual livestock listing.</small></a>
          <a class="admin-action" href="/admin/breeds/new"><span>+</span><b>Add Breed</b><small>Add a breed to the library.</small></a>
          <a class="admin-action" href="/admin/dairy/new"><span>+</span><b>Add Dairy Product</b><small>Add a product and availability.</small></a>
          <a class="admin-action" href="/admin/gallery"><span>+</span><b>Add Gallery Photo</b><small>Upload a farm photograph.</small></a>
          <a class="admin-action" href="/admin/settings#business"><span>i</span><b>Edit Business</b><small>Phone, email, address and hours.</small></a>
          <a class="admin-action" href="/admin/settings#seo"><span>⌕</span><b>Edit SEO</b><small>Search titles, descriptions and sharing.</small></a>
        </div>
      </section>

      <section class="admin-panel">
        <div class="panel-heading"><div><p class="eyebrow">Customer activity</p><h2>Latest inquiries</h2></div><a class="text-link" href="/admin/inquiries">View all →</a></div>
        <div class="table-wrap"><table><thead><tr><th>Customer</th><th>Interest</th><th>Status</th><th>Date</th></tr></thead><tbody>
          <% latestInquiries.forEach(item => { %>
            <tr><td><strong><%= item.full_name %></strong><small><%= item.phone %></small></td><td><%= item.animal_name || item.product_name || item.inquiry_type %></td><td><span class="admin-status <%= item.status.toLowerCase() %>"><%= item.status %></span></td><td><%= item.created_at %></td></tr>
          <% }) %>
          <% if(!latestInquiries.length){ %><tr><td colspan="4">No inquiries yet.</td></tr><% } %>
        </tbody></table></div>
      </section>

      <div class="dashboard-columns">
        <section class="admin-panel">
          <div class="panel-heading"><div><p class="eyebrow">Inventory</p><h2>Recently added animals</h2></div><a class="text-link" href="/admin/animals">Manage →</a></div>
          <div class="mini-list">
            <% recentAnimals.forEach(animal => { %>
              <a class="mini-list-item" href="/admin/animals/<%= animal.id %>/edit">
                <div class="mini-list-thumb"><% if(animal.image){ %><img src="/uploads/<%= animal.image %>" alt="<%= animal.name %>" loading="lazy"><% } else { %><span>🐄</span><% } %></div>
                <div><strong><%= animal.name %></strong><small><%= animal.breed_name || animal.breed || animal.category %> · <%= animal.availability %></small></div>
              </a>
            <% }) %>
            <% if(!recentAnimals.length){ %><div class="empty-state">No animals have been added yet.</div><% } %>
          </div>
        </section>

        <section class="admin-panel">
          <div class="panel-heading"><div><p class="eyebrow">Photography</p><h2>Recently added gallery photos</h2></div><a class="text-link" href="/admin/gallery">Manage →</a></div>
          <div class="mini-gallery">
            <% recentGallery.forEach(item => { %>
              <a href="/admin/gallery" class="mini-gallery-item" title="Edit gallery content">
                <img src="/uploads/<%= item.image %>" alt="<%= item.title %>" loading="lazy">
                <span><%= item.title %></span>
              </a>
            <% }) %>
            <% if(!recentGallery.length){ %><div class="empty-state">No gallery photos have been added yet.</div><% } %>
          </div>
        </section>
      </div>
    </div>
  </main>
</body></html>
