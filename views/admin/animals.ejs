<%- include('../partials/head', { title, description: 'Manage Delamere Farm livestock.' }) %><body class="admin-body"><header class="admin-header"><div class="container admin-header-inner"><a class="brand" href="/admin"><span class="brand-mark">DF</span><span class="brand-text">Delamere Farm Admin</span></a><nav><a href="/admin/settings">Settings</a><a href="/">Site</a><a href="/admin">Dashboard</a><form method="post" action="/admin/logout"><button>Logout</button></form></nav></div></header><main class="admin-main"><div class="container"><div class="admin-title"><div><p class="eyebrow">Catalog</p><h1>Animals</h1></div><a class="btn btn-primary" href="/admin/animals/new">+ Add Animal</a></div><section class="admin-panel"><div class="table-wrap"><table><thead><tr><th>Animal</th><th>Category</th><th>Status</th><th>Featured</th><th>Actions</th></tr></thead><tbody><% animals.forEach(animal => { %><tr><td><div class="admin-media"><img src="<%= helpers?.imageUrl ? helpers.imageUrl(animal.image) : (animal.image ? '/uploads/'+animal.image : '/images/placeholder.svg') %>" alt=""><div><strong><%= animal.name %></strong><small><%= animal.breed || '—' %></small></div></div></td><td><%= animal.category %></td><td><%= animal.availability %></td><td><%= animal.featured ? 'Yes' : 'No' %></td><td><a class="table-link" href="/admin/animals/<%= animal.id %>/edit">Edit</a><form class="inline-form" method="post" action="/admin/animals/<%= animal.id %>/delete" onsubmit="return confirm('Delete this animal?')"><button class="danger-link" type="submit">Delete</button></form></td></tr><% }) %><% if (!animals.length) { %><tr><td colspan="5">No animals added yet.</td></tr><% } %></tbody></table></div></section></div></main></body></html>
