<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main><%- include('../partials/page-hero', { eyebrow: 'Visual stories', heading: 'Farm Gallery', lead: 'A growing collection of photographs from Delamere Farm.' }) %><section class="section section-light"><div class="container"><div class="filter-pills"><a class="pill <%= !selectedCategory ? 'active' : '' %>" href="/gallery">All</a><% categories.forEach(category => { %><a class="pill <%= selectedCategory === category ? 'active' : '' %>" href="/gallery?category=<%= encodeURIComponent(category) %>"><%= category %></a><% }) %></div><% if (gallery.length) { %><div class="gallery-grid large"> <% gallery.forEach(item => { %><button class="gallery-tile gallery-button image-wrap reveal" type="button" data-lightbox-src="<%= helpers.imageUrl(item.image) %>" data-lightbox-alt="<%= item.title %>"><img src="<%= helpers.imageUrl(item.image) %>" alt="<%= item.title %>" loading="lazy" decoding="async"><span><%= item.title %></span></button><% }) %></div><% } else { %><div class="gallery-placeholder">Gallery photographs will appear here as the farm collection is uploaded.</div><% } %></div></section></main><div class="lightbox" id="lightbox" aria-hidden="true"><button class="lightbox-close" type="button" aria-label="Close image">×</button><img id="lightbox-image" src="" alt=""></div><%- include('../partials/footer') %></body>
