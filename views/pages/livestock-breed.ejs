<%- include('../partials/head', { title, description }) %>
<body>
<%- include('../partials/header') %>

<main>
  <section class="section section-light">
    <div class="container">
      <div class="breadcrumb">
        <a href="/livestock">Livestock</a>
        <span aria-hidden="true">&#8594;</span>
        <a href="/livestock/<%= type.slug %>"><%= type.name %></a>
        <span aria-hidden="true">&#8594;</span>
        <a href="/livestock/<%= type.slug %>/<%= classification.slug %>"><%= classification.name %></a>
        <span aria-hidden="true">&#8594;</span>
        <strong><%= breed.name %></strong>
      </div>

      <script type="application/ld+json"><%- JSON.stringify({
        "@context":"https://schema.org",
        "@type":"BreadcrumbList",
        "itemListElement":[
          {"@type":"ListItem","position":1,"name":"Livestock","item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock"},
          {"@type":"ListItem","position":2,"name":type.name,"item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock/" + type.slug},
          {"@type":"ListItem","position":3,"name":classification.name,"item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock/" + type.slug + "/" + classification.slug},
          {"@type":"ListItem","position":4,"name":breed.name,"item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock/" + type.slug + "/" + classification.slug + "/" + breed.slug}
        ]
      }) %></script>

      <div class="detail-grid livestock-breed-detail">
        <div class="detail-media image-wrap">
          <img
            id="breed-source-cover"
            src="<%= helpers.imageUrl(breed.image) %>"
            alt="<%= breed.name %> <%= type.name %> at <%= site.name %>"
            decoding="async"
            referrerpolicy="no-referrer"
          >
        </div>
        <div class="detail-copy">
          <span class="card-kicker"><%= type.name %> · <%= classification.name %></span>
          <h1><%= breed.name %> <%= type.name %> at <%= site.name %></h1>
          <p class="detail-lead"><%= breed.description || 'Quality livestock breed presented by Delamere Farm.' %></p>
          <div class="facts">
            <div><span>Type</span><strong><%= type.name %></strong></div>
            <div><span>Classification</span><strong><%= classification.name %></strong></div>
            <div><span>Individual animals</span><strong><%= animals.length %></strong></div>
            <div><span>Price guide</span><strong><%= breed.price_range || 'Price on request' %></strong></div>
          </div>
        </div>
      </div>

      <div class="breed-navigation" style="margin-top:24px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
        <a class="btn btn-secondary" href="/livestock/<%= type.slug %>/<%= classification.slug %>">View <%= classification.name %> <%= type.name %></a>
        <a class="btn btn-secondary" href="/animals">Browse Individual Animals</a>
        <% if (classifications && classifications.length > 1) { %>
          <% classifications.filter(item => item.id !== classification.id).forEach(item => { %>
            <a class="text-link" href="/livestock/<%= type.slug %>/<%= item.slug %>">More <%= item.name %> breeds</a>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Breed photography is loaded directly from Wikimedia Commons.
       No image files are copied into the repository. The search is breed-specific
       and prioritises African/Kenyan results before falling back to the wider breed. -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Breed photography</p>
          <h2><%= breed.name %> in the field</h2>
          <p>High-resolution reference photography sourced directly from Wikimedia Commons. Images remain hosted by their original source.</p>
        </div>
      </div>

      <div id="breed-source-gallery" class="gallery-grid compact" aria-live="polite">
        <div class="gallery-placeholder" style="grid-column:1/-1">
          Loading high-resolution <%= breed.name %> photographs…
        </div>
      </div>

      <p style="margin-top:14px;font-size:.76rem;color:var(--muted)">
        Photography source: <a class="text-link" href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer">Wikimedia Commons</a>.
        Individual image licences and creators are available from each source page.
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Individual animals</p>
          <h2><%= breed.name %> at Delamere Farm</h2>
        </div>
      </div>

      <% if (animals.length) { %>
        <div class="card-grid">
          <% animals.forEach(animal => { %>
            <%- include('../partials/animal-card', { animal, helpers }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>No individual animals added yet</h3>
          <p>This breed is configured and ready, but individual animals have not been added to it yet.</p>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script>
(() => {
  const breed = <%- JSON.stringify(breed.name) %>;
  const gallery = document.getElementById('breed-source-gallery');
  const cover = document.getElementById('breed-source-cover');
  const api = 'https://commons.wikimedia.org/w/api.php';

  const searchTerms = [
    breed + ' Kenya',
    breed + ' Africa',
    breed + ' South Africa',
    breed + ' Tanzania',
    breed + ' Uganda',
    breed
  ];

  const escapeHtml = value => String(value || '').replace(/[&<>"']/g, char => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'
  }[char]));

  async function searchCommons(term) {
    const params = new URLSearchParams({
      action: 'query',
      generator: 'search',
      gsrsearch: term + ' filetype:bitmap',
      gsrnamespace: '6',
      gsrlimit: '30',
      prop: 'imageinfo',
      iiprop: 'url|size|mime',
      iiurlwidth: '1600',
      format: 'json',
      origin: '*'
    });
    const response = await fetch(api + '?' + params.toString(), {
      headers: { 'Accept': 'application/json' }
    });
    if (!response.ok) throw new Error('Wikimedia request failed');
    const data = await response.json();
    return Object.values(data.query?.pages || {})
      .map(page => {
        const info = page.imageinfo?.[0];
        return {
          title: page.title,
          url: info?.thumburl || info?.url,
          width: Number(info?.width || 0),
          height: Number(info?.height || 0),
          mime: info?.mime || '',
          page: 'https://commons.wikimedia.org/wiki/' + encodeURIComponent(page.title.replace(/ /g, '_'))
        };
      })
      .filter(item => item.url && item.mime.startsWith('image/') && item.width >= 1000 && item.height >= 700);
  }

  async function loadBreedPhotos() {
    const unique = new Map();

    for (const term of searchTerms) {
      try {
        const photos = await searchCommons(term);
        photos.forEach(photo => {
          const key = photo.url.split('?')[0];
          if (!unique.has(key)) unique.set(key, photo);
        });
      } catch (_) {
        // Continue with the next source query so one failed query does not break the page.
      }
      if (unique.size >= 18) break;
    }

    const photos = Array.from(unique.values()).slice(0, 18);

    if (!photos.length) {
      gallery.innerHTML = '<div class="gallery-placeholder" style="grid-column:1/-1">The source gallery is temporarily unavailable. Please refresh to try again.</div>';
      return;
    }

    cover.src = photos[0].url;

    gallery.innerHTML = photos.map((photo, index) => `
      <a class="gallery-tile" href="${escapeHtml(photo.page)}" target="_blank" rel="noopener noreferrer" style="min-height:0;aspect-ratio:16/10" aria-label="Open source for <%= breed.name %> photograph ${index + 1}">
        <img src="${escapeHtml(photo.url)}" alt="<%= breed.name %> photograph ${index + 1}" loading="${index < 3 ? 'eager' : 'lazy'}" decoding="async" referrerpolicy="no-referrer">
        <span>Wikimedia Commons · View source</span>
      </a>
    `).join('');
  }

  loadBreedPhotos();
})();
</script>

<%- include('../partials/footer') %>
</body>