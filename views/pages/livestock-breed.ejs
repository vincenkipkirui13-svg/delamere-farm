<%- include('../partials/head', { title, description }) %>
<body>
<%- include('../partials/header') %>

<main>
  <section class="section section-light">
    <div class="container">
      <div class="breadcrumb">
        <a href="/livestock">Livestock</a>
        <span aria-hidden="true">&#8594;</span>
        <a href="/livestock/<%= type.slug %>"><%= type.name %></a>
        <span aria-hidden="true">&#8594;</span>
        <a href="/livestock/<%= type.slug %>/<%= classification.slug %>"><%= classification.name %></a>
        <span aria-hidden="true">&#8594;</span>
        <strong><%= breed.name %></strong>
      </div>

      <script type="application/ld+json"><%- JSON.stringify({
        "@context":"https://schema.org",
        "@type":"BreadcrumbList",
        "itemListElement":[
          {"@type":"ListItem","position":1,"name":"Livestock","item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock"},
          {"@type":"ListItem","position":2,"name":type.name,"item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock/" + type.slug},
          {"@type":"ListItem","position":3,"name":classification.name,"item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock/" + type.slug + "/" + classification.slug},
          {"@type":"ListItem","position":4,"name":breed.name,"item":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/livestock/" + type.slug + "/" + classification.slug + "/" + breed.slug}
        ]
      }) %></script>

      <div class="detail-grid livestock-breed-detail">
        <div class="detail-media image-wrap">
          <img
            id="breed-source-cover"
            src="<%= helpers.imageUrl(breed.image) %>"
            alt="<%= breed.name %> <%= type.name %> at <%= site.name %>"
            decoding="async"
            referrerpolicy="no-referrer"
          >
        </div>
        <div class="detail-copy">
          <span class="card-kicker"><%= type.name %> · <%= classification.name %></span>
          <h1><%= breed.name %> <%= type.name %> at <%= site.name %></h1>
          <p class="detail-lead"><%= breed.description || 'Quality livestock breed presented by Delamere Farm.' %></p>
          <div class="facts">
            <div><span>Type</span><strong><%= type.name %></strong></div>
            <div><span>Classification</span><strong><%= classification.name %></strong></div>
            <div><span>Individual animals</span><strong><%= animals.length %></strong></div>
            <div><span>Price guide</span><strong><%= breed.price_range || 'Price on request' %></strong></div>
          </div>
        </div>
      </div>

      <div class="breed-navigation" style="margin-top:24px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
        <a class="btn btn-secondary" href="/livestock/<%= type.slug %>/<%= classification.slug %>">View <%= classification.name %> <%= type.name %></a>
        <a class="btn btn-secondary" href="/animals">Browse Individual Animals</a>
        <% if (classifications && classifications.length > 1) { %>
          <% classifications.filter(item => item.id !== classification.id).forEach(item => { %>
            <a class="text-link" href="/livestock/<%= type.slug %>/<%= item.slug %>">More <%= item.name %> breeds</a>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Breed photography</p>
          <h2><%= breed.name %> in the field</h2>
          <p>High-resolution breed photography displayed directly on Delamere Farm.</p>
        </div>
      </div>

      <div id="breed-source-gallery" class="gallery-grid compact" aria-live="polite">
        <div class="gallery-placeholder" style="grid-column:1/-1">
          Loading high-resolution <%= breed.name %> photographs…
        </div>
      </div>

      <p style="margin-top:14px;font-size:.76rem;color:var(--muted)">
        Photography is sourced from Wikimedia Commons and displayed here directly. Source and licence information remains available in the image metadata.
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Individual animals</p>
          <h2><%= breed.name %> at Delamere Farm</h2>
          <p>Each animal card now uses a different high-quality breed photograph when a farm photograph is not yet attached.</p>
        </div>
      </div>

      <% if (animals.length) { %>
        <div class="card-grid" id="individual-animals-grid">
          <% animals.forEach(animal => { %>
            <%- include('../partials/animal-card', { animal, helpers }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>No individual animals added yet</h3>
          <p>This breed is configured and ready, but individual animals have not been added to it yet.</p>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script>
(() => {
  const breed = <%- JSON.stringify(breed.name) %>;
  const livestockType = <%- JSON.stringify(type.name) %>;
  const gallery = document.getElementById('breed-source-gallery');
  const cover = document.getElementById('breed-source-cover');
  const animalCards = Array.from(document.querySelectorAll('#individual-animals-grid .animal-card'));
  const localPhotos = {
    'Friesian / Holstein':['/animal-photos/cattle/friesian-holstein/friesian-holstein-01.jfif','/animal-photos/cattle/friesian-holstein/friesian-holstein-02.jfif','/animal-photos/cattle/friesian-holstein/friesian-holstein-03.jfif'],
    'Ayrshire':['/animal-photos/cattle/ayrshire/ayrshire-01.jfif','/animal-photos/cattle/ayrshire/ayrshire-02.jfif'],
    'Jersey':['/animal-photos/cattle/jersey/jersey-01.jfif','/animal-photos/cattle/jersey/jersey-02.jfif'],
    'Guernsey':['/animal-photos/cattle/guernsey/guernsey-01.jfif'],
    'Girolando':['/animal-photos/cattle/girolando/girolando-01.jfif','/animal-photos/cattle/girolando/girolando-02.jfif'],
    'Sahiwal':Array.from({length:10},(_,i)=>'/animal-photos/cattle/sahiwal/sahiwal-'+String(i+1).padStart(2,'0')+'.jfif'),
    'Boran':['/animal-photos/cattle/boran/boran-01.jfif'],
    'Brahman':Array.from({length:5},(_,i)=>'/animal-photos/cattle/brahman/brahman-'+String(i+1).padStart(2,'0')+'.jfif'),
    'Fleckvieh':Array.from({length:8},(_,i)=>'/animal-photos/cattle/fleckvieh/fleckvieh-'+String(i+1).padStart(2,'0')+'.jfif'),
    'Dorper':Array.from({length:10},(_,i)=>'/animal-photos/sheep/dorper/dorper-'+String(i+1).padStart(2,'0')+'.jfif'),
    'Hampshire':['/animal-photos/sheep/hampshire/hampshire-01.jfif','/animal-photos/sheep/hampshire/hampshire-02.jfif','/animal-photos/sheep/hampshire/hampshire-03.jfif'],
    'Red Maasai':['/animal-photos/sheep/red-maasai/red-maasai-01.jfif','/animal-photos/sheep/red-maasai/red-maasai-02.jfif','/animal-photos/sheep/red-maasai/red-maasai-04.jfif','/animal-photos/sheep/red-maasai/red-maasai-05.jfif','/animal-photos/sheep/red-maasai/red-maasai-06.jfif','/animal-photos/sheep/red-maasai/red-maasai-07.jfif'],
    'Boer':['/animal-photos/goats/boer/boer-01.jfif','/animal-photos/goats/boer/boer-02.jfif','/animal-photos/goats/boer/boer-03.jfif','/animal-photos/goats/boer/boer-04.jfif','/animal-photos/goats/boer/boer-05.jfif'],
    'Kalahari Red':['/animal-photos/goats/kalahari-red/kalahari-red-01.jfif']
  };
  const typeWord={Cattle:['cattle','cow','bull','calf'],Sheep:['sheep','ram','ewe','lamb'],Goats:['goat','goats','kid','doe','buck']}[livestockType]||[];
  const escapeHtml=value=>String(value||'').replace(/[&<>"']/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
  function renderPhotos(photos){
    if(!photos.length){gallery.innerHTML='<div class="gallery-placeholder" style="grid-column:1/-1">No verified breed photographs are available yet. Please add approved photographs from the Delamere Farm admin area.</div>';return;}
    cover.src=photos[0].url||photos[0];
    animalCards.forEach((card,index)=>{const photo=photos[index%photos.length],image=card.querySelector('img');if(!image)return;image.src=photo.url||photo;image.alt=card.querySelector('h3')?.textContent?.trim()||(breed+' at Delamere Farm');image.loading=index<3?'eager':'lazy';image.decoding='async';image.referrerPolicy='no-referrer';});
    gallery.innerHTML=photos.map((photo,index)=>{const src=photo.url||photo;return '<figure class="gallery-tile" style="min-height:0;aspect-ratio:16/10;margin:0"><img src="'+escapeHtml(src)+'" alt="'+escapeHtml(breed+' photograph '+(index+1))+'" loading="'+(index<3?'eager':'lazy')+'" decoding="async" referrerpolicy="no-referrer"><figcaption style="padding:8px 10px;font-size:.72rem;color:var(--muted)">'+escapeHtml(breed)+' photograph '+(index+1)+'</figcaption></figure>';}).join('');
  }
  async function searchVerifiedCommons(term){
    const api='https://commons.wikimedia.org/w/api.php';
    const params=new URLSearchParams({action:'query',generator:'search',gsrsearch:'"'+term+'" filetype:bitmap',gsrnamespace:'6',gsrlimit:'40',prop:'imageinfo',iiprop:'url|size|mime',iiurlwidth:'1600',format:'json',origin:'*'});
    const response=await fetch(api+'?'+params.toString(),{headers:{Accept:'application/json'}});
    if(!response.ok)throw new Error('Image search failed');
    const data=await response.json();
    return Object.values(data.query?.pages||{}).map(page=>{const info=page.imageinfo?.[0];return{title:page.title,url:info?.url,width:Number(info?.width||0),height:Number(info?.height||0),mime:info?.mime||''};}).filter(item=>{if(!item.url||!item.mime.startsWith('image/')||item.width<1200||item.height<800)return false;const h=(item.title||'').toLowerCase();const terms=breed.toLowerCase().split(/\s*[/–-]\s*/).filter(Boolean);return terms.some(t=>h.includes(t))&&typeWord.some(t=>h.includes(t));});
  }
  async function loadBreedPhotos(){
    if(localPhotos[breed]?.length){renderPhotos(localPhotos[breed]);return;}
    const terms=[breed+' '+livestockType,breed+' '+(typeWord[0]||'')],unique=new Map();
    for(const term of terms){try{const photos=await searchVerifiedCommons(term);photos.forEach(photo=>{const key=photo.url.split('?')[0];if(!unique.has(key))unique.set(key,photo);});}catch(_){}}
    renderPhotos(Array.from(unique.values()).slice(0,24));
  }

  loadBreedPhotos();
})();
</script>

<%- include('../partials/footer') %>
</body>