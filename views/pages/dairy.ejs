<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main><%- include('../partials/page-hero', { eyebrow: 'From the farm', heading: 'Dairy Products', lead: 'Discover our dairy range and contact Delamere Farm for information, availability, and next steps.' }) %><section class="section section-light"><div class="container"><form class="catalog-toolbar single-search" method="get" action="/dairy"><label class="search-field"><span>Search</span><input type="search" name="search" value="<%= search %>" placeholder="Search dairy products" aria-label="Search dairy products"></label><button class="btn btn-secondary" type="submit">Search</button></form><% if (products.length) { %><div class="card-grid"> <% products.forEach(product => { %><%- include('../partials/dairy-card', { product, helpers }) %><% }) %></div><% } else { %><div class="empty-state"><h3>No dairy products found</h3><p>Try a different search or check again later.</p></div><% } %></div></section></main><%- include('../partials/footer') %></body>
