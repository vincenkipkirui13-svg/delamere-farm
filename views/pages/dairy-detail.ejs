<%- include('../partials/head', { title, description }) %>
<% const siteBase = (siteUrl || 'https://delamerefarm.org').replace(/\/$/, ''); %>
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Dairy Products","item":siteBase + "/dairy"},
    {"@type":"ListItem","position":2,"name":product.name,"item":siteBase + "/dairy/" + product.slug}
  ]
}) %></script>
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"Product",
  "name":product.name,
  "description":product.description || undefined,
  "image":product.image ? ((siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + helpers.imageUrl(product.image)) : undefined,
  "brand":{"@type":"Brand","name":site.name || "Delamere Farm"},
  "offers":{
    "@type":"Offer",
    "url":(siteUrl || "https://delamerefarm.org").replace(/\/$/,"") + "/dairy/" + product.slug,
    "availability":product.availability === "Available" ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
    "priceCurrency":"KES",
    "price":product.price !== null && product.price !== undefined ? Number(product.price) : undefined
  }
}) %></script>
<body><%- include('../partials/header') %><main><section class="detail-section section-cream"><div class="container"><nav class="detail-breadcrumbs" aria-label="Breadcrumb"><a href="/dairy">Dairy Products</a><span aria-hidden="true">/</span><span aria-current="page"><%= product.name %></span></nav><a class="back-link" href="/dairy">← Back to dairy</a><div class="detail-grid"><div class="detail-media image-wrap"><img src="<%= helpers.imageUrl(product.image) %>" alt="<%= product.name %> from <%= site.name %>" decoding="async"></div><div class="detail-copy"><div class="detail-topline"><span class="status-badge <%= product.availability === 'Available' ? 'status-available' : 'status-muted' %>"><%= product.availability %></span><span class="card-kicker"><%= product.category %></span></div><h1><%= product.name %></h1><p class="detail-lead"><%= product.description %></p><div class="facts"><% if(product.price!==null&&product.price!==undefined){%><div><span>Price</span><strong>KSh <%= Number(product.price).toLocaleString('en-KE') %><%= product.unit ? ' / '+product.unit : '' %></strong></div><%}%><% if(product.unit){%><div><span>Unit</span><strong><%= product.unit %></strong></div><%}%></div><a class="btn btn-primary btn-wide" href="/contact?type=Dairy%20Product&product=<%= product.id %>">Inquire About This Product <span>→</span></a></div></div></div></section><% if (related.length) { %><section class="section section-light"><div class="container"><div class="section-heading"><p class="eyebrow">More from our range</p><h2>Explore other dairy products.</h2></div><div class="card-grid"><% related.forEach(item => { %><%- include('../partials/dairy-card', { product: item, helpers }) %><% }) %></div></div></section><% } %></main><%- include('../partials/footer') %></body>
