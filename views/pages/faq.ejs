<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main><%- include('../partials/page-hero', { eyebrow: 'Need to know', heading: 'Frequently Asked Questions', lead: 'Helpful answers for customers exploring Delamere Farm online.' }) %><section class="section section-light"><div class="container faq-list"><% if (faqs.length) { faqs.forEach((faq, index) => { %><details class="faq-item" <%= index === 0 ? 'open' : '' %>><summary><%= faq.question %><span>+</span></summary><p><%= faq.answer %></p></details><% }) } else { %><div class="empty-state">FAQs are being updated.</div><% } %></div></section><section class="cta-section"><div class="container cta-inner reveal"><p class="eyebrow eyebrow-light">Still have a question?</p><h2>Send us your inquiry.</h2><p>The Delamere Farm team can help with animals, dairy products, and availability.</p><a class="btn btn-light" href="/contact">Contact Delamere Farm</a></div></section></main><%- include('../partials/footer') %></body>
