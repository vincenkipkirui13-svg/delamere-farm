<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main>
<%- include('../partials/page-hero', { eyebrow: 'Livestock', heading: 'Our Animals', lead: 'Explore livestock currently presented by Delamere Farm. Select an animal to see more details and send a direct inquiry.' }) %>
<section class="section section-light"><div class="container">
  <form class="catalog-toolbar" method="get" action="/animals"><label class="search-field"><span>Search</span><input type="search" name="search" value="<%= search %>" placeholder="Search by animal, breed or category" aria-label="Search animals"></label><label class="filter-field"><span>Category</span><select name="category"><option value="">All animals</option><% categories.forEach(category => { %><option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>><%= category %></option><% }) %></select></label><button class="btn btn-secondary" type="submit">Search</button></form>
  <div class="results-line"><span><strong><%= total %></strong> animal<%= total === 1 ? '' : 's' %> found</span><% if (search || selectedCategory) { %><a class="text-link" href="/animals">Clear filters</a><% } %></div>
  <% if (animals.length) { %><div class="card-grid"> <% animals.forEach(animal => { %><%- include('../partials/animal-card', { animal, helpers }) %><% }) %></div><% } else { %><div class="empty-state"><h3>No animals found</h3><p>Try another search or category.</p></div><% } %>
  <% if (pages > 1) { %><nav class="pagination" aria-label="Animals pages"><% if (page > 1) { %><a href="?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(selectedCategory) %>">← Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a href="?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>&category=<%= encodeURIComponent(selectedCategory) %>">Next →</a><% } %></nav><% } %>
</div></section></main><%- include('../partials/footer') %></body>
