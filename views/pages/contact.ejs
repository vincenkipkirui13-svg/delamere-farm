<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main><%- include('../partials/page-hero', { eyebrow: site.pageContent.contact.eyebrow, heading: site.pageContent.contact.title, lead: site.pageContent.contact.lead }) %><section class="section section-light"><div class="container contact-grid"><div class="contact-copy"><p class="eyebrow"><%= site.pageContent.contact.sectionEyebrow %></p><h2><%= site.pageContent.contact.sectionTitle %></h2><p><%= site.pageContent.contact.sectionDescription %></p><div class="direct-contact-actions">

  <% if (site.whatsapp || site.phone) { %>
    <a
      class="btn btn-whatsapp"
      href="<%= helpers.whatsappUrl(site.whatsapp || site.phone, site.whatsappMessage) %>"
      target="_blank"
      rel="noopener"
    >
      <span class="whatsapp-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32">
          <path d="M16 3C8.82 3 3 8.82 3 16c0 2.3.6 4.56 1.73 6.56L3 29l6.63-1.69A12.93 12.93 0 0 0 16 29c7.18 0 13-5.82 13-13S23.18 3 16 3Zm0 23.64c-1.98 0-3.92-.53-5.62-1.54l-.4-.24-3.94 1 .99-3.84-.26-.4A10.98 10.98 0 1 1 16 26.64Zm6.03-8.26c-.33-.17-1.94-.96-2.24-1.07-.3-.11-.52-.17-.74.17-.22.33-.85 1.07-1.04 1.29-.19.22-.38.25-.7.08-.33-.17-1.39-.51-2.65-1.62-.98-.87-1.64-1.94-1.83-2.27-.19-.33-.02-.51.14-.68.15-.15.33-.38.49-.57.16-.19.22-.33.33-.55.11-.22.06-.41-.03-.57-.08-.17-.74-1.78-1.01-2.44-.27-.64-.54-.55-.74-.56h-.63c-.22 0-.57.08-.87.41-.3.33-1.14 1.11-1.14 2.7s1.17 3.13 1.33 3.35c.16.22 2.3 3.51 5.57 4.92.78.34 1.39.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.94-.79 2.21-1.56.27-.77.27-1.43.19-1.56-.08-.14-.3-.22-.63-.39Z"/>
        </svg>
      </span>
      Chat on WhatsApp
    </a>
  <% } %>

  <% if (site.email) { %>
    <a class="btn btn-email" href="mailto:<%= site.email %>">
      Email the Farm
    </a>
  <% } %>

</div><div class="contact-items"><% if (site.phone) { %><div><span>Phone</span><a href="tel:<%= site.phone %>"><%= site.phone %></a></div><% } %><% if (site.email) { %><div><span>Email</span><a href="mailto:<%= site.email %>"><%= site.email %></a></div><% } %><% if (site.location) { %><div><span>Location</span><strong><%= site.location %></strong></div><% } %></div><div class="contact-note"><strong>Note</strong><p>This website does not process online payments. Inquiries are sent to Delamere Farm for follow-up.</p></div></div><div class="form-card"><% if (errors && errors.length) { %><div class="form-errors" role="alert"><strong>Please check the following:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><form method="post" action="/contact" novalidate><input type="hidden" name="animal_id" value="<%= form.animal_id %>"><input type="hidden" name="dairy_product_id" value="<%= form.dairy_product_id %>"><div class="selected-inquiry"><span>Inquiry about</span><strong><%= selectedAnimal?.name || selectedProduct?.name || (form.inquiry_type === 'General Inquiry' ? 'General Inquiry' : 'Selected item') %></strong></div><label>Full Name *<input required name="full_name" maxlength="80" value="<%= form.full_name %>" autocomplete="name"></label><label>Phone Number *<input required name="phone" maxlength="25" value="<%= form.phone %>" autocomplete="tel" inputmode="tel"></label><label>Email <span class="optional">optional</span><input type="email" name="email" maxlength="160" value="<%= form.email %>" autocomplete="email"></label><label>Subject <span class="optional">optional</span><input name="subject" maxlength="160" value="<%= form.subject||'' %>"></label><label>Inquiry Type *<select required name="inquiry_type"><option value="General Inquiry" <%= form.inquiry_type === 'General Inquiry' ? 'selected' : '' %>>General Inquiry</option><option value="Animal" <%= form.inquiry_type === 'Animal' ? 'selected' : '' %>>Animal</option><option value="Dairy Product" <%= form.inquiry_type === 'Dairy Product' ? 'selected' : '' %>>Our Product</option></select></label><label>Message / Details *<textarea required name="message" maxlength="1500" rows="6" placeholder="Tell us what you are looking for, your preferred quantity, timing, or any other useful details."><%= form.message %></textarea></label><button class="btn btn-primary btn-wide" type="submit">Send Inquiry <span>→</span></button></form></div></div></section></main><%- include('../partials/footer') %></body>
