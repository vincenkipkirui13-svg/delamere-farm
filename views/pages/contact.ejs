<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main><%- include('../partials/page-hero', { eyebrow: 'Get in touch', heading: 'Talk to Delamere Farm', lead: 'Tell us what you are looking for and include a few details so the team can respond appropriately.' }) %><section class="section section-light"><div class="container contact-grid"><div class="contact-copy"><p class="eyebrow">Contact details</p><h2>Let’s start a conversation.</h2><p>Use the form to send an inquiry. Required fields keep the process simple: your name, phone number, inquiry type, and a few useful details.</p><div class="contact-items"><% if (site.phone) { %><div><span>Phone</span><a href="tel:<%= site.phone %>"><%= site.phone %></a></div><% } %><% if (site.email) { %><div><span>Email</span><a href="mailto:<%= site.email %>"><%= site.email %></a></div><% } %><% if (site.location) { %><div><span>Location</span><strong><%= site.location %></strong></div><% } %></div><div class="contact-note"><strong>Note</strong><p>This website does not process online payments. Inquiries are sent to Delamere Farm for follow-up.</p></div></div><div class="form-card"><% if (errors && errors.length) { %><div class="form-errors" role="alert"><strong>Please check the following:</strong><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div><% } %><form method="post" action="/contact" novalidate><input type="hidden" name="animal_id" value="<%= form.animal_id %>"><input type="hidden" name="dairy_product_id" value="<%= form.dairy_product_id %>"><div class="selected-inquiry"><span>Inquiry about</span><strong><%= selectedAnimal?.name || selectedProduct?.name || (form.inquiry_type === 'General Inquiry' ? 'General Inquiry' : 'Selected item') %></strong></div><label>Full Name *<input required name="full_name" maxlength="80" value="<%= form.full_name %>" autocomplete="name"></label><label>Phone Number *<input required name="phone" maxlength="25" value="<%= form.phone %>" autocomplete="tel" inputmode="tel"></label><label>Email <span class="optional">optional</span><input type="email" name="email" maxlength="160" value="<%= form.email %>" autocomplete="email"></label><label>Inquiry Type *<select required name="inquiry_type"><option value="General Inquiry" <%= form.inquiry_type === 'General Inquiry' ? 'selected' : '' %>>General Inquiry</option><option value="Animal" <%= form.inquiry_type === 'Animal' ? 'selected' : '' %>>Animal</option><option value="Dairy Product" <%= form.inquiry_type === 'Dairy Product' ? 'selected' : '' %>>Dairy Product</option></select></label><label>Message / Details *<textarea required name="message" maxlength="1500" rows="6" placeholder="Tell us what you are looking for, your preferred quantity, timing, or any other useful details."><%= form.message %></textarea></label><button class="btn btn-primary btn-wide" type="submit">Send Inquiry <span>→</span></button></form></div></div></section></main><%- include('../partials/footer') %></body>
