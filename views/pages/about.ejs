<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main>
<%- include('../partials/page-hero', { eyebrow: siteSettings.about_eyebrow, heading: siteSettings.about_title, lead: siteSettings.about_lead }) %>
<section class="section section-light"><div class="container split-section"><div class="split-visual image-wrap reveal"><img src="<%= helpers.mediaUrl(siteSettings.aboutImage) %>" alt="<%= site.name %>" loading="lazy" decoding="async"><% if(siteSettings.aboutCaption){%><span class="image-caption"><%= siteSettings.aboutCaption %></span><%}%></div><div class="split-copy reveal"><p class="eyebrow"><%= siteSettings.about_intro_eyebrow %></p><h2><%= siteSettings.about_intro_title %></h2><p><%= siteSettings.about_intro %></p><p><%= siteSettings.about_story %></p></div></div>
<% if(siteSettings.aboutImage2 || siteSettings.aboutImage3){ %><div class="container about-image-strip"><% if(siteSettings.aboutImage2){ %><div class="image-wrap reveal"><img src="<%= helpers.mediaUrl(siteSettings.aboutImage2) %>" alt="<%= site.name %>" loading="lazy" decoding="async"></div><% } %><% if(siteSettings.aboutImage3){ %><div class="image-wrap reveal"><img src="<%= helpers.mediaUrl(siteSettings.aboutImage3) %>" alt="<%= site.name %>" loading="lazy" decoding="async"></div><% } %></div><% } %>
</div></section>
<% if(siteSettings.about_mission || siteSettings.about_vision || siteSettings.about_values){ %><section class="section section-cream"><div class="container"><div class="values-grid"><% if(siteSettings.about_mission){%><div class="value-card reveal"><span>01</span><h3>Mission</h3><p><%= siteSettings.about_mission %></p></div><%}%><% if(siteSettings.about_vision){%><div class="value-card reveal"><span>02</span><h3>Vision</h3><p><%= siteSettings.about_vision %></p></div><%}%><% if(siteSettings.about_values){%><div class="value-card reveal"><span>03</span><h3>Values</h3><p><%= siteSettings.about_values %></p></div><%}%></div></div></section><% } %>
<section class="cta-section"><div class="container cta-inner reveal"><p class="eyebrow eyebrow-light"><%= site.pageContent.aboutCta.eyebrow %></p><h2><%= site.pageContent.aboutCta.title %></h2><p><%= site.pageContent.aboutCta.description %></p><div class="button-row centered-buttons"><a class="btn btn-light" href="/animals"><%= site.pageContent.aboutCta.primaryText %></a><a class="btn btn-light-outline" href="/contact"><%= site.pageContent.aboutCta.secondaryText %></a></div></div></section>
</main><%- include('../partials/footer') %>