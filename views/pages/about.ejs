<%- include('../partials/head', { title, description }) %>
<body>
<%- include('../partials/header') %>
<main>
  <%- include('../partials/page-hero', { eyebrow: 'Our story', heading: 'Rooted in farming, connected to people.', lead: 'Delamere Farm is presented through a simple idea: make it easy for customers to discover quality livestock and dairy offerings, then speak directly with the farm.' }) %>
  <section class="section section-light"><div class="container split-section"><div class="split-visual image-wrap reveal"><img src="<%= helpers.mediaUrl(aboutImage) %>" alt="Delamere Farm" loading="lazy" decoding="async"><% if (aboutCaption) { %><span class="image-caption"><%= aboutCaption %></span><% } %></div><div class="split-copy reveal"><p class="eyebrow">About Delamere Farm</p><h2>Good farming deserves a clear customer experience.</h2><p>We believe trust starts with clear information. This website is designed to give customers an easy view of our livestock and our products while keeping the next step simple: a direct conversation with Delamere Farm.</p><p>Our digital home can evolve with the farm. New animals, our products, photographs, frequently asked questions, and availability can be updated without rebuilding the site.</p></div></div></section>
  <section class="section section-cream"><div class="container"><div class="section-heading centered reveal"><p class="eyebrow">Our approach</p><h2>Three things guide the experience.</h2></div><div class="values-grid"><div class="value-card reveal"><span>01</span><h3>Care</h3><p>Thoughtful presentation of livestock, products, and farm information.</p></div><div class="value-card reveal"><span>02</span><h3>Clarity</h3><p>Useful details, straightforward availability, and easy-to-understand inquiries.</p></div><div class="value-card reveal"><span>03</span><h3>Connection</h3><p>A direct path from browsing online to speaking with the people behind the farm.</p></div></div></div></section>
  <section class="cta-section"><div class="container cta-inner reveal"><p class="eyebrow eyebrow-light">Come closer to the farm</p><h2>Explore what is currently available.</h2><p>Browse our livestock and dairy catalog or get in touch with the team.</p><div class="button-row centered-buttons"><a class="btn btn-light" href="/animals">Explore Animals</a><a class="btn btn-light-outline" href="/contact">Contact Us</a></div></div></section>
</main>
<%- include('../partials/footer') %>
