<%- include('../partials/head', { title, description }) %>
<body><%- include('../partials/header') %><main>
<section class="detail-section section-light"><div class="container"><a class="back-link" href="/animals">← Back to animals</a><div class="detail-grid"><div class="detail-media image-wrap"><img src="<%= helpers.imageUrl(animal.image) %>" alt="<%= animal.name %>" decoding="async"></div><div class="detail-copy"><div class="detail-topline"><span class="status-badge <%= animal.availability === 'Available' ? 'status-available' : 'status-muted' %>"><%= animal.availability %></span><span class="card-kicker"><%= animal.category %></span></div><h1><%= animal.name %></h1><p class="detail-lead"><%= animal.description %></p><div class="facts"><% if (animal.breed) { %><div><span>Breed</span><strong><%= animal.breed %></strong></div><% } %><% if (animal.age) { %><div><span>Age</span><strong><%= animal.age %></strong></div><% } %><% if (animal.gender) { %><div><span>Gender</span><strong><%= animal.gender %></strong></div><% } %></div><a class="btn btn-primary btn-wide" href="/contact?type=Animal&animal=<%= animal.id %>">Inquire About This Animal <span>→</span></a></div></div></div></section>
<% if (related.length) { %><section class="section section-cream"><div class="container"><div class="section-heading"><p class="eyebrow">You may also like</p><h2>More livestock to explore.</h2></div><div class="card-grid"><% related.forEach(item => { %><%- include('../partials/animal-card', { animal: item, helpers }) %><% }) %></div></div></section><% } %>
</main><%- include('../partials/footer') %></body>
