<%- include('../partials/head', { title, description }) %>
<% const siteBase = (siteUrl || 'https://delamerefarm.org').replace(/\/$/, ''); %>
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Livestock","item":siteBase + "/livestock"},
    ...(taxonomy ? [
      {"@type":"ListItem","position":2,"name":taxonomy.type_name,"item":siteBase + "/livestock/" + taxonomy.type_slug},
      ...(taxonomy.classification_name ? [{"@type":"ListItem","position":3,"name":taxonomy.classification_name,"item":siteBase + "/livestock/" + taxonomy.type_slug + "/" + taxonomy.classification_slug}] : []),
      ...(taxonomy.breed_name ? [{"@type":"ListItem","position":4,"name":taxonomy.breed_name,"item":siteBase + "/livestock/" + taxonomy.type_slug + "/" + taxonomy.classification_slug + "/" + taxonomy.breed_slug}] : [])
    ] : []),
    {"@type":"ListItem","position":taxonomy ? (taxonomy.classification_name ? 5 : 3) : 2,"name":animal.name,"item":siteBase + "/animals/" + animal.slug}
  ]
}) %></script>
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org",
  "@type":"Product",
  "name":animal.name,
  "description":animal.description || description,
  "image":[animal.image, ...(photos || []).map(photo => photo.image)].filter(Boolean).map(image => siteBase + "/uploads/" + image),
  "brand":{"@type":"Brand","name":site.name || "Delamere Farm"},
  "category":animal.breed || animal.category || "Livestock",
  "offers":{"@type":"Offer","url":siteBase + "/animals/" + animal.slug,"availability":animal.availability === "Available" ? "https://schema.org/InStock" : "https://schema.org/OutOfStock","priceCurrency":"KES","price":animal.price !== null && animal.price !== undefined ? Number(animal.price) : undefined}
}) %></script>
<body><%- include('../partials/header') %><main><section class="detail-section section-light"><div class="container"><nav class="detail-breadcrumbs" aria-label="Breadcrumb"><a href="/livestock">Livestock</a><span aria-hidden="true">/</span><% if (taxonomy) { %><a href="/livestock/<%= taxonomy.type_slug %>"><%= taxonomy.type_name %></a><% if (taxonomy.classification_name) { %><span aria-hidden="true">/</span><a href="/livestock/<%= taxonomy.type_slug %>/<%= taxonomy.classification_slug %>"><%= taxonomy.classification_name %></a><% } %><% if (taxonomy.breed_name && taxonomy.classification_name) { %><span aria-hidden="true">/</span><a href="/livestock/<%= taxonomy.type_slug %>/<%= taxonomy.classification_slug %>/<%= taxonomy.breed_slug %>"><%= taxonomy.breed_name %></a><% } %><% } %><span aria-hidden="true">/</span><span aria-current="page"><%= animal.name %></span></nav><a class="back-link" href="/animals">← Back to animals</a><div class="detail-grid"><div><div class="detail-media image-wrap"><img src="<%= helpers.imageUrl(animal.image) %>" alt="<%= animal.name %> — <%= animal.breed || animal.category || 'livestock' %> at <%= site.name %>" decoding="async"></div><% if(photos&&photos.length){%><div class="admin-thumb-grid public-animal-gallery"><% photos.forEach(photo=>{%><img src="/uploads/<%= photo.image %>" alt="<%= animal.name %> — additional photo at <%= site.name %>" loading="lazy"><%})%></div><%}%></div><div class="detail-copy"><div class="detail-topline"><span class="status-badge <%= animal.availability==='Available'?'status-available':'status-muted' %>"><%= animal.availability %></span><span class="card-kicker"><%= animal.livestock_classification || animal.category %></span></div><h1><%= animal.name %></h1><% if(animal.animal_id){%><p><strong>Animal ID:</strong> <%= animal.animal_id %></p><%}%><p class="detail-lead"><%= animal.description %></p><div class="facts"><% [['Breed',animal.breed],['Age',animal.age],['Sex',animal.sex||animal.gender],['Date of birth',animal.date_of_birth],['Price',animal.price!==null&&animal.price!==undefined?'KSh '+Number(animal.price).toLocaleString('en-KE'):animal.price_range]].forEach(([label,value])=>{if(value){%><div><span><%= label %></span><strong><%= value %></strong></div><%}})%></div><% if(animal.health_information){%><div class="detail-extra"><h3>Health information</h3><p><%= animal.health_information %></p></div><%}%><% if(animal.breeding_information){%><div class="detail-extra"><h3>Breeding information</h3><p><%= animal.breeding_information %></p></div><%}%><% if(animal.production_information){%><div class="detail-extra"><h3>Production information</h3><p><%= animal.production_information %></p></div><%}%><a class="btn btn-primary btn-wide" href="/contact?type=Animal&animal=<%= animal.id %>">Inquire About This Animal <span>→</span></a></div></div></div></section><% if(related.length){%><section class="section section-cream"><div class="container"><div class="section-heading"><p class="eyebrow">You may also like</p><h2>More livestock to explore.</h2></div><div class="card-grid"><% related.forEach(item=>{%><%- include('../partials/animal-card',{animal:item,helpers}) %><%})%></div></div></section><%}%></main><%- include('../partials/footer') %></body>